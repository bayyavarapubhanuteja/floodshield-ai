# ---- FloodShield AI configuration (copy to .env) ----
FS_ENV=development
FS_SECRET_KEY=change-me-to-a-long-random-string
FS_DATABASE_URL=postgresql+psycopg2://floodshield:floodshield@db:5432/floodshield
FS_REDIS_URL=redis://redis:6379/0
FS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FS_DEFAULT_CITY=hyderabad
FS_SEED_ADMIN_PASSWORD=Admin@123
FS_DEMO_SECONDS_TOTAL=150
# simulated | open-meteo reference | disabled
FS_WEATHER_PROVIDER=simulated
# Optional notification adapters (unset => deliveries are logged as SIMULATED)
FS_SMTP_HOST=
FS_SMS_GATEWAY_URL=
# Optional YOLO weights for CCTV analysis (requires `pip install ultralytics`)
FS_YOLO_WEIGHTS=
